# LiveKit Cloud project: Settings > API keys. Speech recognition and speech synthesis use LiveKit Inference with this key.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The Mastra agent's model (openai/gpt-4.1-mini).
OPENAI_API_KEY=

# Neon: Connection details > connection string (sslmode=require).
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Kernel cloud browsers (Walmart cart): dashboard > API keys.
KERNEL_API_KEY=

# Gemini (AI Studio): picks the Walmart product for a request.
GOOGLE_GENERATIVE_AI_API_KEY=
