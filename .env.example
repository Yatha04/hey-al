# LiveKit Cloud project: Settings > API keys. Speech recognition and speech synthesis use LiveKit Inference with this key.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The Mastra agent's model (openai/gpt-4.1-mini).
OPENAI_API_KEY=

# Exa: dashboard.exa.ai > API keys. Web search for hours, places, services.
EXA_API_KEY=

# Neon: Connection details > connection string (sslmode=verify-full).
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=verify-full

# Kernel cloud browsers (Amazon, Duke Energy): dashboard > API keys.
KERNEL_API_KEY=
