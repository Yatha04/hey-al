{
  "name": "hey-al",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "agent": "tsx --env-file=.env mastra/voice-worker.ts dev",
    "agent:download": "livekit-agents download-files",
    "studio": "mastra dev --dir mastra",
    "test:integration": "vitest run tests/integration --silent=false",
    "site:login": "tsx --env-file=.env scripts/site-login.ts",
    "flows": "tsx --env-file=.env scripts/kernel-flows.ts",
    "test": "vitest run tests/unit"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.1",
    "@livekit/agents-plugin-livekit": "^1.9.1",
    "@livekit/agents-plugin-silero": "^1.9.1",
    "@livekit/components-react": "^2.9.24",
    "@mastra/core": "^1.74.0",
    "@mastra/livekit": "^0.4.2",
    "@mastra/memory": "^1.35.0",
    "@mastra/pg": "^1.29.0",
    "@onkernel/sdk": "^0.119.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "next": "16.3.8",
    "playwright-core": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "mastra": "^1.32.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
